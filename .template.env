# Generated into .env by `just init` (op inject).
# Keep this template in git; never commit the generated .env.

# App Store Connect API key metadata.
# The private key is retrieved separately into a temporary .p8.
SIGNING_IDENTITY="{{ op://Personal/Apple/SIGNING_IDENTITY }}"
APP_STORE_DEV_KEY_ID="{{ op://Personal/Apple/APP_STORE_DEV_KEY_ID }}"
APP_STORE_DEV_KEY_NAME="{{ op://Personal/Apple/APP_STORE_DEV_KEY_NAME }}"
APP_STORE_DEV_KEY_ISSUER_ID="{{ op://Personal/Apple/APP_STORE_DEV_KEY_ISSUER_ID }}"

# Local Keychain profile created or updated by `just init`.
NOTARYTOOL_PROFILE="math-reduce"

GITHUB_TOKEN="{{ op://Personal/GitHub Mika/PERSONAL_ACCESS_TOKEN }}"
GITHUB_REPOSITORY="kitschpatrol/math-reduce"
